# Set these as ENVIRONMENT VARIABLES (the app does not read a .env file by itself).
# PowerShell example:  $env:API_KEY = "change-me"; python -m uvicorn app.main:app
# Every value is optional.
DATABASE_URL=sqlite:///./talentiq.db        # or postgresql+psycopg://user:pass@host/db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=30
MAX_BATCH_FILES=60
EMBEDDING_BACKEND=auto                      # auto | minilm | tfidf. auto = MiniLM sentence embeddings if available, else TF-IDF (the reason is shown)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Folder with the model files for the pure-NumPy runtime (fetch once: python scripts/fetch_minilm.py). Default: backend/storage/models/all-MiniLM-L6-v2
# EMBEDDING_MODEL_DIR=
API_KEY=                                    # empty = no auth (local demo). Set it for any shared deployment.
RETENTION_DAYS=0                            # 0 = keep until a recruiter deletes the data
STORE_ORIGINAL_FILES=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_ENABLED=true
